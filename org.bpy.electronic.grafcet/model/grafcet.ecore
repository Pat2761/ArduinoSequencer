<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="ArduinoGrafcet" nsURI="http://org.bpy.electronic.grafcet/" nsPrefix="ArduinoGrafcet">
  <eClassifiers xsi:type="ecore:EClass" name="Model">
    <eStructuralFeatures xsi:type="ecore:EReference" name="grafcetEntry" lowerBound="1"
        eType="#//GrafcetEntry" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grafcetEnded" lowerBound="1"
        eType="#//GrafcetEnded" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grafcets" upperBound="-1"
        eType="#//Grafcet" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sequencerPath" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projectName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Grafcet">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entryPoint" lowerBound="1"
        eType="#//GrafcetEntryPoint" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="next" eType="#//Grafcet"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="autorun" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="end" eType="#//GrafcetEnded"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="steps" lowerBound="1" upperBound="-1"
        eType="#//GrafcetStep" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reports" upperBound="-1"
        eType="#//Report" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetEntryPoint">
    <eOperations name="newOperation1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="step" lowerBound="1" eType="#//GrafcetStep"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="report" eType="#//Report"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TransitionAction" eSuperTypes="#//GrafcetElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="transitionFct" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actionFct" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetStep">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startingGraphicalPoint"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entryConnector" lowerBound="1"
        eType="#//GrafcetConnector" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grafcetElements" lowerBound="1"
        upperBound="-1" eType="#//GrafcetElement" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetEntry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="startingGrafcet" lowerBound="1"
        eType="#//Grafcet"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetEnded"/>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nextStep" eType="#//GrafcetStep"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="location" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nextReportStep" eType="#//Report"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uuid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Action" eSuperTypes="#//GrafcetElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actionFct" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Transition" eSuperTypes="#//GrafcetElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="transitionFct" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PassThrough" eSuperTypes="#//GrafcetElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="transitionFct" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Report">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nextStep" eType="#//GrafcetStep"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GrafcetConnector">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grafcetElements" lowerBound="1"
        upperBound="-1" eType="#//GrafcetElement"/>
  </eClassifiers>
</ecore:EPackage>

<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" xmlns:tool="http://www.eclipse.org/sirius/description/tool/1.1.0" xmlns:tool_1="http://www.eclipse.org/sirius/diagram/description/tool/1.1.0" xmlns:validation="http://www.eclipse.org/sirius/description/validation/1.1.0" name="grafcet" version="12.0.0.2017041100">
  <ownedViewpoints name="model_vp" label="Sequencer viewpoint" modelFileExtension="grafcet">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="HighLevel" label="High level diagram" showOnStartup="true" domainClass="ArduinoGrafcet::Model" enablePopupBars="true">
      <validationSet>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="missingStartElement" label="Missing start element" level="ERROR" message="Missing start element" targetClass="ArduinoGrafcet::Model">
          <audits auditExpression="aql:self.checkMissingStartElement()"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="missindEndElement" label="Missing end element" level="ERROR" message="Missing end element" targetClass="ArduinoGrafcet::Model">
          <audits auditExpression="aql:self.checkMissingEndElement()"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="grafcetEndedConnection" label="Grafcet Ended Connection" level="ERROR" message="Ended element must be connected to a graph." targetClass="ArduinoGrafcet::GrafcetEnded">
          <audits auditExpression="aql:self.checkUncallEndedElement()"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="checkCIdentifier" label="check C Identifier" level="ERROR" message="aql:'Identifier \'' + self.name + '\' must be a valid identifier'" targetClass="ArduinoGrafcet::Grafcet">
          <audits auditExpression="aql:self.checkGraphName()"/>
        </ownedRules>
      </validationSet>
      <defaultLayer name="Default">
        <nodeMappings name="mainEntry" label="Entry" domainClass="ArduinoGrafcet::GrafcetEntry">
          <style xsi:type="style:EllipseNodeDescription" labelSize="12" labelExpression="['Begin'/]" iconPath="/org.bpy.electronic.grafcet.design/icons/EnterIcon.jpg" sizeComputationExpression="1" labelPosition="node" resizeKind="NSEW" horizontalDiameterComputationExpression="30" verticalDiameterComputationExpression="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="Grafcet" navigationDescriptions="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.3/@ownedTools[name='openGrafcetDescription']" doubleClickDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.3/@ownedTools[name='editGrafcetAttribute']" domainClass="ArduinoGrafcet::Grafcet">
          <style xsi:type="style:SquareDescription" labelSize="12" showIcon="false" iconPath="/org.bpy.electronic.grafcet.design/icons/grafcet.jpg" tooltipExpression="aql:self.description" labelPosition="node" resizeKind="NSEW" width="30" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="mainEnded" label="Ended" domainClass="ArduinoGrafcet::GrafcetEnded">
          <style xsi:type="style:EllipseNodeDescription" labelSize="12" labelExpression="['End'/]" iconPath="/org.bpy.electronic.grafcet.design/icons/ExitIcon.jpg" labelPosition="node" resizeKind="NSEW" horizontalDiameterComputationExpression="30" verticalDiameterComputationExpression="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="rootNode" label="Root node" semanticCandidatesExpression="aql:self" doubleClickDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.3/@ownedTools[name='editModelAttribute']" domainClass="ArduinoGrafcet::Model">
          <style xsi:type="style:NoteDescription" labelSize="12" showIcon="false" labelExpression="feature:projectName" tooltipExpression="aql:self.description" sizeComputationExpression="25" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='yellow']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="EntryRelation" label="Entry relation" deletionDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='deleteEdge']" sourceMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='mainEntry']" targetMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']" targetFinderExpression="[startingGrafcet/]" reconnections="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='reconnectTargetEdge']">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="graphRelation" label="Graph relation" deletionDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='deleteEdge']" sourceMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']" targetMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='mainEnded']" targetFinderExpression="[next/]" reconnections="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='reconnectTargetEdge'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='reconnectSourceEdge']">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="endRelation" label="End relation" deletionDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='deleteEdge']" sourceMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']" targetMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='mainEnded']" targetFinderExpression="[end/]" reconnections="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='reconnectTargetEdge'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@toolSections.2/@ownedTools[name='reconnectSourceEdge']">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <toolSections name="menu" label="Menu">
          <ownedTools xsi:type="tool:GroupMenu" name="userModelGroupMenu" label="Root Group popup menu" locationURI="menu:root">
            <itemDescriptions xsi:type="tool:OperationAction" name="editParameters" label="Edit parameters" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::Grafcet)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                  <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.openGrafcetAttrirbuteEditor()"/>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
            <itemDescriptions xsi:type="tool:OperationAction" name="commuteActifMenu" label="Commute grafcet state" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::Grafcet)" forceRefresh="true">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:SetValue" featureName="autorun" valueExpression="aql:not self.eGet('autorun')"/>
                <firstModelOperations xsi:type="" featureName="isActif" valueExpression=" "/>
              </initialOperation>
            </itemDescriptions>
            <itemDescriptions xsi:type="tool:OperationAction" name="editGeneralInformation" label="Edit General Information" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::Model)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.fillModelParameters()"/>
              </initialOperation>
            </itemDescriptions>
            <itemDescriptions xsi:type="tool:OperationAction" name="openOrCreateGrafcetEditor" label="Open grafcet editor" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::Grafcet)" elementsToSelect="var:self">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:SetValue" featureName="entryPoint" valueExpression="aql:self.openOrCreateGrafcetDiagram()"/>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
        </toolSections>
        <toolSections name="paletteObjects" label="Elements">
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="entryElement" label="Entry " precondition="aql:self.checkEntryExistence()" forceRefresh="true" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='mainEntry']" iconPath="/org.bpy.electronic.grafcet.design/icons/EnterIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::GrafcetEntry" referenceName="grafcetEntry"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="createSequencer" label="Create Sequencer" forceRefresh="true" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']" iconPath="/org.bpy.electronic.grafcet.design/icons/grafcet.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::Grafcet" referenceName="grafcets">
                  <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="ToBeDefined"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="endElement" label="End element" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='mainEnded']" iconPath="/org.bpy.electronic.grafcet.design/icons/ExitIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::GrafcetEnded" referenceName="grafcetEnded"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <toolSections name="paletteLinks" label="Connector">
          <ownedTools xsi:type="tool_1:EdgeCreationDescription" name="linkCreation" label="Link" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@edgeMappings[name='EntryRelation'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@edgeMappings[name='graphRelation']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="[source/]">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and target.oclIsTypeOf(ArduinoGrafcet::Grafcet) and source.checkConnectionGrafcetToGrafcet(target)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetEntry) and target.oclIsTypeOf(ArduinoGrafcet::Grafcet) and source.checkConnectionGrafcetEntryToGrafcet(target)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="startingGrafcet" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetEnded) and source.checkConnectionGrafcetToEnd(target)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="[target/]"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteEdge" label="Delete edge">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:element.oclIsTypeOf(ArduinoGrafcet::GrafcetEntry)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="startingGrafcet" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:element.oclIsTypeOf(ArduinoGrafcet::Grafcet) and element.next&lt;>null">
                  <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:element.oclIsTypeOf(ArduinoGrafcet::Grafcet) and element.end&lt;>null">
                  <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="aql:null"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:ReconnectEdgeDescription" name="reconnectTargetEdge" label="Reconnect Target Edge">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="[element/]">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and target.oclIsTypeOf(ArduinoGrafcet::Grafcet)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="[target/]"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetEnded)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="[target/]"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and element.oclIsTypeOf(ArduinoGrafcet::GrafcetEntry)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="startingGrafcet" valueExpression="[target/]"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:ReconnectEdgeDescription" name="reconnectSourceEdge" label="Reconnect Source Edge" reconnectionKind="RECONNECT_SOURCE">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext">
                <subModelOperations xsi:type="tool:ChangeContext" browseExpression="[target/]">
                  <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and target.oclIsTypeOf(ArduinoGrafcet::Grafcet)">
                    <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="[source.next/]"/>
                  </subModelOperations>
                  <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and source.end.oclIsTypeOf(ArduinoGrafcet::GrafcetEnded)">
                    <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="[source.end/]"/>
                  </subModelOperations>
                </subModelOperations>
                <subModelOperations xsi:type="tool:ChangeContext" browseExpression="[source/]">
                  <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and source.next.oclIsTypeOf(ArduinoGrafcet::Grafcet)">
                    <subModelOperations xsi:type="tool:SetValue" featureName="next" valueExpression="aql:null"/>
                  </subModelOperations>
                  <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Grafcet) and source.end.oclIsTypeOf(ArduinoGrafcet::GrafcetEnded)">
                    <subModelOperations xsi:type="tool:SetValue" featureName="end" valueExpression="aql:null"/>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
        </toolSections>
        <toolSections name="Tools" label="Tools">
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="editGrafcetAttribute" label="Edit Grafcet Attribute" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openGrafcetAttrirbuteEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DiagramNavigationDescription" name="openGrafcetDescription" label="Open Grafcet Description" forceRefresh="true" diagramDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']">
            <containerViewVariable name="containerView"/>
            <containerVariable name="container"/>
            <representationNameVariable name="diagramName"/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="editModelAttribute" label="Edit Model Attribute" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='rootNode']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.editModelAttributes()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <decorationDescriptionsSet>
          <decorationDescriptions xsi:type="description_1:MappingBasedDecoration" name="grafphIsActif" position="NORTH_WEST" preconditionExpression="aql:self.autorun" imageExpression="org.bpy.electronic.grafcet.design\icons\led-rounded-h-red.jpg" tooltipExpression="This grafcet is active at initialization" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']"/>
          <decorationDescriptions xsi:type="description_1:MappingBasedDecoration" name="grafphIsInactif" position="NORTH_WEST" preconditionExpression="aql:not self.autorun" imageExpression="org.bpy.electronic.grafcet.design\icons\led-rounded-h-grey.jpg" tooltipExpression="This grafcet is inactive at initialization" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='HighLevel']/@defaultLayer/@nodeMappings[name='Grafcet']"/>
        </decorationDescriptionsSet>
      </defaultLayer>
    </ownedRepresentations>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="grafcetDiagram" label="Grafcet Diagram" domainClass="ArduinoGrafcet::Grafcet" enablePopupBars="true">
      <defaultLayer name="Default">
        <nodeMappings name="entryGrafcetnode" label="Entry Grafcet Node" semanticCandidatesExpression="[entryPoint/]" domainClass="ArduinoGrafcet::GrafcetEntryPoint">
          <style xsi:type="style:SquareDescription" labelSize="12" showIcon="false" labelExpression="Entry point" labelPosition="node" resizeKind="NSEW" width="30" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="reportElement" label="Report Element" semanticCandidatesExpression="[reports/]" doubleClickDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@toolSections.2/@ownedTools[name='reportAttributeEditor']" domainClass="ArduinoGrafcet::Report">
          <style xsi:type="style:EllipseNodeDescription" labelSize="12" showIcon="false" labelExpression="aql:self.nextStep.comment" sizeComputationExpression="" labelPosition="node" horizontalDiameterComputationExpression="25" verticalDiameterComputationExpression="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="entryToStep" label="Entry to step" deletionDescription="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@toolSections.4/@ownedTools[name='entryToStep']" sourceMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@nodeMappings[name='entryGrafcetnode']" targetMapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']" targetFinderExpression="[step/]" reconnections="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@toolSections.3/@ownedTools[name='reconnectEntryPointTarget']">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>

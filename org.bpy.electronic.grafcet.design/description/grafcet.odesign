            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:ContainerCreationDescription" name="stepCreation" label="Step" containerMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.createStepElement()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="actionTransitionCreation" label="Transition/Action" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionAction']" iconPath="/org.bpy.electronic.grafcet.design/icons/TransitionActionIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::TransitionAction" referenceName="grafcetElements">
                <subModelOperations xsi:type="tool:SetValue" featureName="actionFct" valueExpression="actionToDefine"/>
                <subModelOperations xsi:type="tool:SetValue" featureName="transitionFct" valueExpression="transitionToDefine"/>
                <subModelOperations xsi:type="tool_1:CreateView" mapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionAction']" containerViewExpression="var:containerView"/>
                <subModelOperations xsi:type="tool:SetValue" featureName="uuid" valueExpression="aql:self.getUUID()"/>
                <subModelOperations xsi:type="tool:Let" variableName="dummy" valueExpression="service:containerView.centerBoderedNode()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteStepConnector" label="Delete Step Connector" precondition="false">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="transitionOnly" label="Transition" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionOnly']" iconPath="/org.bpy.electronic.grafcet.design/icons/TransitionIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::Transition" referenceName="grafcetElements">
                <subModelOperations xsi:type="tool:SetValue" featureName="transitionFct" valueExpression="transitionToDefine"/>
                <subModelOperations xsi:type="tool_1:CreateView" mapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionOnly']" containerViewExpression="var:containerView"/>
                <subModelOperations xsi:type="tool:SetValue" featureName="uuid" valueExpression="aql:self.getUUID()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="actionOnly" label="Action" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='actionOnly']" iconPath="/org.bpy.electronic.grafcet.design/icons/ActionIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::Action" referenceName="grafcetElements">
                <subModelOperations xsi:type="tool:SetValue" featureName="actionFct" valueExpression="actionToDefine"/>
                <subModelOperations xsi:type="tool_1:CreateView" mapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='actionOnly']" containerViewExpression="var:containerView"/>
                <subModelOperations xsi:type="tool:SetValue" featureName="uuid" valueExpression="aql:self.getUUID()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="passThrough" label="Pass Through" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='passThrough']" iconPath="/org.bpy.electronic.grafcet.design/icons/passThroughIcon.jpg">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::PassThrough" referenceName="grafcetElements">
                <subModelOperations xsi:type="tool_1:CreateView" mapping="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='passThrough']" containerViewExpression="var:containerView"/>
                <subModelOperations xsi:type="tool:SetValue" featureName="uuid" valueExpression="aql:self.getUUID()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="reportCreation" label="Report" nodeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@nodeMappings[name='reportElement']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="ArduinoGrafcet::Report" referenceName="reports"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <toolSections name="diagramTools" label="Diagram tools">
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="stepDoubleClick" label="Step attributes edition" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.openStepAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="transitionActionAttributeEditor" label="Transition/Action attribute editor" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionAction']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openTransitionActionAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="transitionAttributeEditor" label="Transition attribute editor" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='transitionOnly']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openTransitionAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="actionAttributeEditor" label="Action attribute editor" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='actionOnly']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openActionAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="passThroughAttributeEditor" label="Pass through attribute editor" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@containerMappings[name='stepContainer']/@subNodeMappings[name='passThrough']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openPassThroughAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DoubleClickDescription" name="reportAttributeEditor" label="Report Attribute Editor" mappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@nodeMappings[name='reportElement']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:Let" valueExpression="aql:self.openReportAttributeEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <toolSections name="grafcetConnector" label="Grafcet connectors">
          <ownedTools xsi:type="tool_1:EdgeCreationDescription" name="grafcetEdgeConnection" label="Connection" edgeMappings="//@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='entryToStep'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='stepToTransitionAction'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='stepToAction'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='stepToTransition'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='stepToPassThrough'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='grafcetElementToStep'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='elementToReport'] //@ownedViewpoints[name='model_vp']/@ownedRepresentations[name='grafcetDiagram']/@defaultLayer/@edgeMappings[name='entryToReport']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="[source/]">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetEntryPoint) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="step" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetConnector) and target.oclIsTypeOf(ArduinoGrafcet::TransitionAction)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="grafcetElements" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetConnector) and target.oclIsTypeOf(ArduinoGrafcet::Action)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="grafcetElements" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetConnector) and target.oclIsTypeOf(ArduinoGrafcet::Transition)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="grafcetElements" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetConnector) and target.oclIsTypeOf(ArduinoGrafcet::PassThrough)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="grafcetElements" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::TransitionAction) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Action) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Transition) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::PassThrough) and target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::TransitionAction) and target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Action) and target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::PassThrough) and target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::Transition) and target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="[target/]"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:source.oclIsTypeOf(ArduinoGrafcet::GrafcetEntryPoint) and target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="report" valueExpression="[target/]"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:ReconnectEdgeDescription" name="reconnectEntryPointTarget" label="Reconnect Entry Point Target">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="step" valueExpression="aql:target"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="report" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="report" valueExpression="aql:target"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="step" valueExpression="aql:null"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:ReconnectEdgeDescription" name="reconnectGrafcetElementTarget" label="Reconnect Grafcet Element Target">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:target.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="aql:target"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="aql:null"/>
                </subModelOperations>
                <subModelOperations xsi:type="tool:If" conditionExpression="aql:target.oclIsTypeOf(ArduinoGrafcet::Report)">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextReportStep" valueExpression="aql:target"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="nextStep" valueExpression="aql:null"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
        </toolSections>
        <toolSections name="deleteElements" label="Delete">
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteEdge" label="Delete Edge">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool:Unset" featureName="nextStep"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteEdgeElementToReport" label="Delete Edge Element To Report">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool:Unset" featureName="nextReportStep"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="entryToStep" label="Entry To Step">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool:Unset" featureName="step"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteStepEntryToElements" label="Delete StepEntry To Elements">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.sourceNode.oclAsType(GrafcetConnector)">
                <subModelOperations xsi:type="tool:Let" valueExpression="service:element.removeTransitionAction(elementView)"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="deleteEntryPointToReport" label="Delete entry point to report">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool:Unset" featureName="report"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="org.bpy.electronic.grafcet.design.validation.MainSequencerValidation"/>
    <ownedJavaExtensions qualifiedClassName="org.bpy.electronic.grafcet.design.validation.EdgeValidation"/>
    <ownedJavaExtensions qualifiedClassName="org.bpy.electronic.grafcet.design.services.GrafcetDiagramService"/>
    <ownedJavaExtensions qualifiedClassName="org.bpy.electronic.grafcet.design.services.HeaderDiagramService"/>
  </ownedViewpoints>
</description:Group>

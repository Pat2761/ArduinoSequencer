        <toolSections name="grafcetMenu" label="Menu">
          <ownedTools xsi:type="tool:GroupMenu" name="stepMenu" label="Step Menu" locationURI="menu:root">
            <itemDescriptions xsi:type="tool:OperationAction" name="editStepAttributes" label="Edit Step Attributes" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::GrafcetStep)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                  <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.openStepAttributeEditor()"/>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool:GroupMenu" name="transitionActionMenu" label="Transition/Action Menu" locationURI="menu:root">
            <itemDescriptions xsi:type="tool:OperationAction" name="editTransitionActionAttributreMenu" label="Edit Transition/Action Attributre Menu" precondition="aql:self.oclIsTypeOf(ArduinoGrafcet::TransitionAction)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element">
                  <subModelOperations xsi:type="tool:SetValue" featureName="name" valueExpression="aql:self.openTransitionActionAttributeEditor()"/>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
        </toolSections>
        <toolSections name="grafcetElements" label="Grafcet Elements">
